# DATABASE_URL PostgreSQL tiene prioridad sobre DB_*; codificar su contraseña si contiene símbolos.
# DATABASE_URL=postgresql+psycopg2://usuario:clave_codificada@localhost:5432/experiencia_db
DB_HOST=localhost
DB_LOGGING=false
DB_NAME=experiencia_db
DB_PASS=
DB_PORT=5432
# Desarrollo: aplica migraciones Alembic al arrancar, incluso en una base vacía.
# En despliegues con migraciones separadas, usar false. No ejecuta semillas ni reset.
DB_SYNCHRONIZE=true
ENABLE_MAINTENANCE_ENDPOINTS=false
DB_USER=usuario_local
JWT_EXPIRES_IN=1d
# Generar con: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
# Claves de prueba de la misma cuenta; no incluir valores reales en este archivo.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Secreto del endpoint o de Stripe CLI; no es la clave sk_test_.
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# Configuración de nuevas reservas: la moneda nunca se convierte implícitamente.
BOOKING_HOLD_MINUTES=15
PAYMENT_CURRENCY=BOB

# Estimación etaria HU-16: rutas a modelos OpenCV (absolutas o relativas a la carpeta del backend).
# Vacías = estimador deshabilitado. No versionar los archivos de modelo.
AGE_FACE_DETECTOR_PATH=
AGE_CLASSIFIER_PROTOTXT_PATH=
AGE_CLASSIFIER_MODEL_PATH=
