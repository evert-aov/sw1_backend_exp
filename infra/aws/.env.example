# --- AWS e Inmutabilidad de Registro ECR ---
AWS_REGION=us-east-1
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY_BACKEND=experiencia-backend
IMAGE_TAG=replace-with-commit-sha

# --- Dominios y Estado de Host en EC2 ---
AWS_API_HOST=api.tu-dominio.com
ACME_EMAIL=ops@tu-dominio.com
EXPERIENCIA_AWS_STATE_DIR=/opt/experiencia-aws/state
EXPERIENCIA_AWS_MODELS_DIR=/opt/experiencia-aws/models

# --- Conector Google Cloud SQL (Cloud SQL Auth Proxy) ---
CLOUD_SQL_INSTANCE_CONNECTION_NAME=tu-proyecto-gcp:us-central1:experiencia-db-prod
CLOUD_SQL_CREDENTIALS_FILE=/path/to/credentials.example.json
# Cadena de conexión hacia el contenedor local cloud-sql-proxy (puerto interno 5432)
DATABASE_URL=postgresql+psycopg2://experiencia_app:tu_password_seguro@cloud-sql-proxy:5432/experiencia_db

# --- Ajustes de Negocio y Base de Datos ---
DB_SYNCHRONIZE=false
ENABLE_MAINTENANCE_ENDPOINTS=false
BOOKING_HOLD_MINUTES=15
PAYMENT_CURRENCY=BOB

# --- Seguridad JWT y CORS ---
JWT_SECRET=replace-with-a-random-secret-before-use
JWT_EXPIRES_IN=1d
# Lista JSON con orígenes autorizados para llamadas con credenciales (sin '*')
CORS_ORIGINS=["https://app.tu-dominio.com"]

# --- Pasarela de Pagos Stripe ---
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
FRONTEND_URL=https://app.tu-dominio.com

# --- Modelos OpenCV HU-16 (Opcionales, montados desde EXPERIENCIA_AWS_MODELS_DIR) ---
AGE_FACE_DETECTOR_PATH=/app/models/face_detection_yunet_2023mar.onnx
AGE_CLASSIFIER_PROTOTXT_PATH=/app/models/age_deploy.prototxt
AGE_CLASSIFIER_MODEL_PATH=/app/models/age_net.caffemodel
